<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="intercity_booking_access.xml"/>
        <exclude domain="sharedpref" path="mobility_private_access.xml"/>
        <exclude domain="sharedpref" path="intercity_booking_access_review.xml"/>
        <exclude domain="sharedpref" path="mobility_private_access_review.xml"/>
        <exclude domain="sharedpref" path="passo_environment.xml"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="intercity_booking_access.xml"/>
        <exclude domain="sharedpref" path="mobility_private_access.xml"/>
        <exclude domain="sharedpref" path="intercity_booking_access_review.xml"/>
        <exclude domain="sharedpref" path="mobility_private_access_review.xml"/>
        <exclude domain="sharedpref" path="passo_environment.xml"/>
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
