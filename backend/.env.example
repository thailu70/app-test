# TEMPLATE ONLY — this file intentionally contains no usable production secrets.
# Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Canonical origin for newly created payment callbacks. Existing DuckDNS access remains supported.
PUBLIC_BASE_URL=https://passo.live

POSTGRES_DB=routepass_db
POSTGRES_USER=routepass
POSTGRES_PASSWORD=
DATABASE_URL=postgres://routepass:CHANGE_ME@db:5432/routepass_db
DATABASE_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=30d
ADMIN_REGISTRATION_SECRET=
QR_SIGNING_KEY=

# PRODUCTION prevents the backend from granting a pass through test-mode payment simulation.
# Live Telebirr checkout is NOT enabled until provider API/signature details are verified.
PAYMENT_MODE=PRODUCTION
# Test-only admin subscription activation. Keep false outside controlled testing.
ALLOW_MANUAL_TEST_RECHARGE=false
# Temporary administrator pass grants. No payment is collected. Disable when no longer needed.
ALLOW_ADMIN_PASS_ACTIVATION=false
# Official Ethio Telecom H5 C2B hosted-checkout integration.
# Keep merchant credentials and private keys ONLY in the VPS .env file.
# Start with TELEBIRR_ENVIRONMENT=test and approved sandbox credentials.
TELEBIRR_ENVIRONMENT=test
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
# Optional full URL overrides; blank uses PUBLIC_BASE_URL. Coordinate changed callbacks with Telebirr.
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=
# Intercity notification override for an existing provider registration; return URLs use PUBLIC_BASE_URL.
# Leave blank on new installations, or retain the registered DuckDNS webhook until Telebirr approves the new domain.
TELEBIRR_INTERCITY_NOTIFY_URL=

DOMAIN_NAME=passo.live
ROUTEPASS_DOMAIN=passo.live
# Keep this alias during migration so installed DuckDNS APKs continue to connect.
ROUTEPASS_LEGACY_DOMAIN=routepass.duckdns.org
ADMIN_EMAIL=admin@example.com
ALLOWED_ORIGINS=https://passo.live,https://routepass.duckdns.org
LOG_LEVEL=info
