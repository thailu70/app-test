# TEMPLATE ONLY — this file intentionally contains no usable production secrets.
# Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

POSTGRES_DB=routepass_db
POSTGRES_USER=routepass
POSTGRES_PASSWORD=
DATABASE_URL=postgres://routepass:CHANGE_ME@db:5432/routepass_db
DATABASE_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=30d
ADMIN_REGISTRATION_SECRET=
QR_SIGNING_KEY=


# Phone OTP via the Ethio Telecom enterprise/developer SMS account.
# Obtain the actual endpoint, credentials, authorization format, and body contract from Ethio Telecom.
OTP_HASH_SECRET=
ETHIOTELECOM_SMS_API_URL=
ETHIOTELECOM_SMS_API_TOKEN=
ETHIOTELECOM_SMS_AUTH_HEADER=Authorization
ETHIOTELECOM_SMS_AUTH_SCHEME=Bearer
ETHIOTELECOM_SMS_SENDER_ID=
# to-message or ethiotelecom-smn; must match the account's issued API contract.
ETHIOTELECOM_SMS_PAYLOAD_MODE=to-message

# PRODUCTION prevents the backend from granting a pass through test-mode payment simulation.
# Live Telebirr checkout is NOT enabled until provider API/signature details are verified.
PAYMENT_MODE=PRODUCTION
# Test-only admin subscription activation. Keep false outside controlled testing.
ALLOW_MANUAL_TEST_RECHARGE=false
# Official Ethio Telecom H5 C2B hosted-checkout integration.
# Keep merchant credentials and private keys ONLY in the VPS .env file.
# Start with TELEBIRR_ENVIRONMENT=test and approved sandbox credentials.
TELEBIRR_ENVIRONMENT=test
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_NOTIFY_URL=https://routepass.duckdns.org/api/subscriptions/telebirr/webhook
TELEBIRR_REDIRECT_URL=https://routepass.duckdns.org/api/subscriptions/telebirr/return

DOMAIN_NAME=api.example.com
ADMIN_EMAIL=admin@example.com
ALLOWED_ORIGINS=https://api.example.com
LOG_LEVEL=info
