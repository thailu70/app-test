# ==============================================================================
# TRANSPORT NAVIGATOR - VPS PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_string_on_your_vps
JWT_EXPIRES_IN=30d

# SQLite Data Directory (Absolute or relative to project root)
DATA_DIR=./data

# Telebirr Merchant Integration Credentials (Optional: simulated by default)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_NOTIFY_URL=http://your-vps-ip:3000/api/subscriptions/telebirr/webhook

# Logging Level
LOG_LEVEL=info
