# ==============================================================================
# ROUTEPASS / TRANSPORT NAVIGATOR - VPS PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database Configuration (Private container inside Docker)
POSTGRES_DB=routepass_db
POSTGRES_USER=routepass
POSTGRES_PASSWORD=replace_with_a_strong_database_password_2026
DATABASE_URL=postgres://routepass:replace_with_a_strong_database_password_2026@db:5432/routepass_db
DATABASE_SSL=false

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_vps_2026
JWT_EXPIRES_IN=30d

# Admin Invitation & Registration Secret (Required to register Admin accounts)
ADMIN_REGISTRATION_SECRET=replace_with_unique_admin_invite_secret_2026

# Server-Side HMAC-SHA256 QR Signing Key (Prevents forgery / client tampering)
QR_SIGNING_KEY=replace_with_a_strong_qr_hmac_signing_key_2026

# Telebirr Payment Mode (TEST for sandbox development, PRODUCTION for live payments)
PAYMENT_MODE=TEST

# Live Telebirr Merchant Integration Credentials (Optional when PAYMENT_MODE=TEST)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_NOTIFY_URL=https://api.yourdomain.et/api/subscriptions/telebirr/webhook

# Domain and SSL
DOMAIN_NAME=api.yourdomain.et
ADMIN_EMAIL=admin@yourdomain.et

# Logging
LOG_LEVEL=info
