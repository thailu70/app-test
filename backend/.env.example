# TEMPLATE ONLY — this file intentionally contains no usable production secrets.
# Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

POSTGRES_DB=routepass_db
POSTGRES_USER=routepass
POSTGRES_PASSWORD=
DATABASE_URL=postgres://routepass:CHANGE_ME@db:5432/routepass_db
DATABASE_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=30d
ADMIN_REGISTRATION_SECRET=
QR_SIGNING_KEY=

# PRODUCTION prevents the backend from granting a pass through test-mode payment simulation.
# Live Telebirr checkout is NOT enabled until provider API/signature details are verified.
PAYMENT_MODE=PRODUCTION
# Test-only admin subscription activation. Keep false outside controlled testing.
ALLOW_MANUAL_TEST_RECHARGE=false
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_WEBHOOK_SECRET=
TELEBIRR_QUERY_URL=
TELEBIRR_NOTIFY_URL=https://api.example.com/api/subscriptions/telebirr/webhook

DOMAIN_NAME=api.example.com
ADMIN_EMAIL=admin@example.com
ALLOWED_ORIGINS=https://api.example.com
LOG_LEVEL=info
